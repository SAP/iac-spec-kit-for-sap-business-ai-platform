{
  "permissions": {
    "allow": [
      "Bash(npx @fission-ai/openspec instructions design --change \"sap-iac-init\" --json)",
      "Bash(npx @fission-ai/openspec status --change \"sap-iac-init\")",
      "Bash(npx @fission-ai/openspec instructions apply --change \"sap-iac-init\" --json)",
      "Bash(golangci-lint run *)",
      "Bash(npx @fission-ai/openspec new change \"sap-iac-init-agent-selection\")",
      "Bash(npx @fission-ai/openspec status --change \"sap-iac-init-agent-selection\" --json)",
      "Bash(npx @fission-ai/openspec instructions proposal --change \"sap-iac-init-agent-selection\" --json)",
      "Bash(npx @fission-ai/openspec instructions specs --change \"sap-iac-init-agent-selection\" --json)",
      "Bash(npx @fission-ai/openspec instructions design --change \"sap-iac-init-agent-selection\" --json)",
      "Bash(npx @fission-ai/openspec instructions tasks --change \"sap-iac-init-agent-selection\" --json)",
      "Bash(npx @fission-ai/openspec status --change \"sap-iac-init-agent-selection\")",
      "Bash(npx @fission-ai/openspec instructions apply --change \"sap-iac-init-agent-selection\" --json)",
      "Bash(go get *)",
      "Bash(go vet *)",
      "Bash(npx @fission-ai/openspec list --json)",
      "Bash(npx @fission-ai/openspec new change \"sap-iac-governance-command\")",
      "Bash(npx @fission-ai/openspec status --change \"sap-iac-governance-command\" --json)",
      "Bash(npx @fission-ai/openspec status --change \"sap-iac-governance-command\")",
      "Bash(npx @fission-ai/openspec instructions apply --change \"sap-iac-governance-command\" --json)",
      "Bash(npm update *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail/ponytail-activate.js\" || exit 0",
            "timeout": 5,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail/ponytail-mode-tracker.js\" || exit 0",
            "timeout": 5,
            "statusMessage": "Tracking ponytail mode..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/ponytail/ponytail-statusline.sh\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": false,
    "skill-creator@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  }
}
